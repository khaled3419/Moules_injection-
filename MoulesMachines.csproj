<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-android</TargetFramework>

    <OutputType>Exe</OutputType>
    <RootNamespace>MoulesMachines</RootNamespace>

    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>Moules Machines</ApplicationTitle>
    <ApplicationId>com.moulesmachines.app</ApplicationId>

    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>

    <ApplicationIcon>Resources\AppIcon\appicon.svg</ApplicationIcon>
    <SplashScreen>Resources\Splash\splash.svg</SplashScreen>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML"
                      Version="0.104.2" />
  </ItemGroup>

</Project>
